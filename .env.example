# Node 24. Variáveis precisam ser exportadas pelo shell/ambiente; este arquivo não é carregado automaticamente.
HOST=127.0.0.1
PORT=3000
OPORA_DB=.local/opora.sqlite
# Busca externa opcional (Brave Search). Configure de forma segura, nunca no frontend.
# OPORA_SEARCH_API_KEY=
# OPORA_SEARCH_MONTHLY_LIMIT=30
# Leitura direta: hosts oficiais básicos já habilitados; adicione outros separados por vírgula.
# Também permita os mesmos hosts na política de rede do ambiente.
# OPORA_SOURCE_ALLOWED_DOMAINS=
# IA opcional. Habilite somente depois de autorizar o uso e os custos do provedor.
# OPORA_ENABLE_AI=1
# OPORA_AI_API_KEY=
# OPORA_AI_MODEL=gpt-4.1-mini
# OPORA_AI_MONTHLY_LIMIT=20
# Obrigatória se HOST não for loopback. Use HTTPS e uma senha forte no deploy.
# OPORA_ACCESS_PASSWORD=
# OPORA_PUBLIC_ORIGIN=https://seu-dominio
